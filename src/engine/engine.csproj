<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <CompressionEnabled>false</CompressionEnabled>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <!--
      Runs language-service work (completions/hover/diagnostics) on background WASM
      threads instead of the browser's main/UI thread. Requires the page to be served
      cross-origin-isolated (COOP/COEP headers) for SharedArrayBuffer — see vite.config.ts
      and public/_headers.
    -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <EngineWebAssetsOutputPath>$(MSBuildProjectDirectory)\..\ui\public\engine\</EngineWebAssetsOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.14.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageReference Include="Basic.Reference.Assemblies.NetStandard20" Version="1.8.12" />
    <PackageReference Include="Basic.Reference.Assemblies.NetStandard21" Version="1.8.12" />
    <PackageReference Include="Basic.Reference.Assemblies.AspNet100" Version="1.8.12" />
  </ItemGroup>

  <Target Name="CopyEngineWebAssets" AfterTargets="Build">
    <ItemGroup>
      <EngineWebAssetFiles Include="$(OutDir)wwwroot\**" />
    </ItemGroup>
    <RemoveDir Directories="$(EngineWebAssetsOutputPath)" Condition="Exists('$(EngineWebAssetsOutputPath)')" />
    <Copy SourceFiles="@(EngineWebAssetFiles)" DestinationFolder="$(EngineWebAssetsOutputPath)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
